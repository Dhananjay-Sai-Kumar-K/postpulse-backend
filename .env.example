# PostPulse Backend Environment Variables

# Server
PORT=3000

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Cache TTL in minutes
CACHE_TTL_MINUTES=5

# Optional live X discussion source through Xquik
XQUIK_API_KEY=your_xquik_api_key
XQUIK_API_BASE_URL=https://xquik.com/api/v1
XQUIK_SEARCH_QUERY=AI OR startup OR SaaS

# Optional AI provider fallbacks used by the post generator
GROQ_API_KEY=
OPENROUTER_API_KEY=
FREELLMAPI_API_KEY=
RELAYFREELLM_API_KEY=
RELAYFREELLM_BASE_URL=http://localhost:8080/v1
